// A separate, minimal fixture for ui_smoke.sh's var_1d case: a single
// genuinely 1-D variable (no lat/lon at all), so the 1-D display path
// (a line-ish rendering, not a 2-D color-contour field) gets exercised.
// Deliberately NOT added to sample.cdl -- sample.cdl is shared by every
// other case, and adding a second variable there changes the
// variable-bucket dropdown's contents (a new dimensionality bucket
// appears) in every one of those screenshots, invalidating all their
// goldens for a change unrelated to what they're each testing.
netcdf sample_1d {
dimensions:
	time = 6 ;
variables:
	double time(time) ;
		time:units = "days since 2000-01-01" ;
	float ts_1d(time) ;
		ts_1d:units = "K" ;
		ts_1d:long_name = "synthetic 1-D time series" ;

data:
	time = 0, 1, 2, 3, 4, 5 ;
	ts_1d = 280.0, 295.0, 270.0, 305.0, 260.0, 290.0 ;
}
